{
	"appId": "uk.org.planik.app",
	"appName": "Planik",
	"webDir": "dist",
	"server": {
		"url": "https://planik.org.uk",
		"cleartext": false
	},
	"plugins": {
		"Camera": {
			"permissions": [
				"camera",
				"photos"
			]
		},
		"GoogleAuth": {
			"scopes": [
				"profile",
				"email"
			],
			"serverClientId": "876860682396-snp1r9u16ftm6mgoksm8348guoerjlnu.apps.googleusercontent.com",
			"forceCodeForRefreshToken": true
		}
	},
	"packageClassList": [
		"SignInWithApple",
		"BarcodeScannerPlugin",
		"CAPCameraPlugin",
		"DevicePlugin",
		"PreferencesPlugin",
		"GoogleAuth"
	]
}
